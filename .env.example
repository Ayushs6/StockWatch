# ──────────────────────────────────────────────────────────────────────────────
# StockWatch — environment variables
#
# 1.  Copy this file to `.env`   to   cp .env.example .env
# 2.  Paste in your own free-tier API keys below.
# 3.  Never commit your real `.env` — it's already in .gitignore.
#
# Every key is optional: the app degrades gracefully if one is missing
# (e.g. no Groq key -> it falls back to Gemini, then to an extractive summary).
# ──────────────────────────────────────────────────────────────────────────────

# Polygon.io — search fallback, company snapshot & candlestick charts
# Free key: https://polygon.io/dashboard/signup
POLYGON_KEY=

# Finnhub — company news (30-day window)
# Free key: https://finnhub.io/register
FINNHUB_KEY=

# Alpha Vantage — news + pre-computed sentiment (25 calls/day on free tier)
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# Groq — primary LLM for analyst-brief summaries (Llama 3.1 8B Instant)
# Free key: https://console.groq.com/keys
GROQ_KEY=

# Google Gemini — LLM fallback (gemini-2.0-flash)
# Free key: https://aistudio.google.com/app/apikey
GEMINI_KEY=

# Twitter/X — optional social bearer token (not required to run)
# https://developer.x.com/en/portal/dashboard
TWITTER_BEARER=
